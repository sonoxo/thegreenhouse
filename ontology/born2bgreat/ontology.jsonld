{
  "@context": {
    "b2g": "urn:born2bgreat:greenhouse:behavioral-health:v1:",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    "type": "@type",
    "id": "@id",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "domain": {"@id": "rdfs:domain", "@type": "@id"},
    "range": {"@id": "rdfs:range", "@type": "@id"},
    "subClassOf": {"@id": "rdfs:subClassOf", "@type": "@id"},
    "sensitivity": {"@id": "b2g:sensitivity", "@type": "@id"},
    "patientKey": "b2g:patientKey",
    "status": "b2g:status",
    "version": "b2g:version",
    "purposeOfUse": "b2g:purposeOfUse"
  },
  "@id": "b2g:Ontology",
  "@type": "owl:Ontology",
  "label": "Born2BGreat Behavioral Health Ontology",
  "comment": "Schema for protected behavioral-health and recovery-service data. Public repository copies MUST NOT contain live PHI/ePHI or Part-2 patient records.",
  "b2g:moduleId": "B2G-BH-1.0",
  "b2g:ownerDomain": "born2bgreat.org",
  "b2g:dataBoundary": "SCHEMA_PUBLIC__INSTANCES_PROTECTED",
  "@graph": [
    {"@id":"b2g:ClinicalResource","@type":"owl:Class","label":"Clinical Resource"},
    {"@id":"b2g:GovernanceResource","@type":"owl:Class","label":"Governance Resource"},
    {"@id":"b2g:Patient","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Patient","comment":"Opaque clinical identity. Direct identifiers belong in PatientIdentity, not on this object."},
    {"@id":"b2g:PatientIdentity","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Patient Identity","comment":"Sealed direct-identification object stored only in the protected identity vault."},
    {"@id":"b2g:ProgramEnrollment","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Program Enrollment"},
    {"@id":"b2g:Referral","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Referral"},
    {"@id":"b2g:EpisodeOfCare","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Episode of Care"},
    {"@id":"b2g:Encounter","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Encounter"},
    {"@id":"b2g:ProgressNote","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Progress Note"},
    {"@id":"b2g:ServicePlan","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Service Plan"},
    {"@id":"b2g:Goal","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Goal"},
    {"@id":"b2g:Objective","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Objective"},
    {"@id":"b2g:Intervention","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Intervention"},
    {"@id":"b2g:CareCoordinationTask","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Care Coordination Task"},
    {"@id":"b2g:Diagnosis","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Diagnosis"},
    {"@id":"b2g:Assessment","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Assessment"},
    {"@id":"b2g:RiskAssessment","@type":"owl:Class","subClassOf":"b2g:Assessment","label":"Risk Assessment"},
    {"@id":"b2g:MentalStatusObservation","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Mental Status Observation"},
    {"@id":"b2g:SubstanceUseObservation","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Substance Use Observation"},
    {"@id":"b2g:MedicationStatement","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Medication Statement"},
    {"@id":"b2g:Appointment","@type":"owl:Class","subClassOf":"b2g:ClinicalResource","label":"Appointment"},
    {"@id":"b2g:Practitioner","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Practitioner"},
    {"@id":"b2g:Organization","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Organization"},
    {"@id":"b2g:Facility","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Facility"},
    {"@id":"b2g:CareTeam","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Care Team"},
    {"@id":"b2g:ConsentDirective","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Consent Directive"},
    {"@id":"b2g:DisclosureEvent","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Disclosure Event"},
    {"@id":"b2g:AccessDecision","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Access Decision"},
    {"@id":"b2g:AuditEvent","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Audit Event"},
    {"@id":"b2g:ProvenanceRecord","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Provenance Record"},
    {"@id":"b2g:Signature","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Signature"},
    {"@id":"b2g:Amendment","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Amendment"},
    {"@id":"b2g:DeIdentificationRecord","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"De-identification Record"},
    {"@id":"b2g:RetentionRule","@type":"owl:Class","subClassOf":"b2g:GovernanceResource","label":"Retention Rule"},

    {"@id":"b2g:identifies","@type":"owl:ObjectProperty","label":"identifies","domain":"b2g:PatientIdentity","range":"b2g:Patient"},
    {"@id":"b2g:hasEnrollment","@type":"owl:ObjectProperty","label":"has enrollment","domain":"b2g:Patient","range":"b2g:ProgramEnrollment"},
    {"@id":"b2g:hasEpisode","@type":"owl:ObjectProperty","label":"has episode","domain":"b2g:Patient","range":"b2g:EpisodeOfCare"},
    {"@id":"b2g:initiates","@type":"owl:ObjectProperty","label":"initiates","domain":"b2g:Referral","range":"b2g:EpisodeOfCare"},
    {"@id":"b2g:hasServicePlan","@type":"owl:ObjectProperty","label":"has service plan","domain":"b2g:EpisodeOfCare","range":"b2g:ServicePlan"},
    {"@id":"b2g:hasGoal","@type":"owl:ObjectProperty","label":"has goal","domain":"b2g:ServicePlan","range":"b2g:Goal"},
    {"@id":"b2g:hasObjective","@type":"owl:ObjectProperty","label":"has objective","domain":"b2g:Goal","range":"b2g:Objective"},
    {"@id":"b2g:hasEncounter","@type":"owl:ObjectProperty","label":"has encounter","domain":"b2g:EpisodeOfCare","range":"b2g:Encounter"},
    {"@id":"b2g:documentedBy","@type":"owl:ObjectProperty","label":"documented by","domain":"b2g:Encounter","range":"b2g:ProgressNote"},
    {"@id":"b2g:usesIntervention","@type":"owl:ObjectProperty","label":"uses intervention","domain":"b2g:Encounter","range":"b2g:Intervention"},
    {"@id":"b2g:assesses","@type":"owl:ObjectProperty","label":"assesses","domain":"b2g:Encounter","range":"b2g:Assessment"},
    {"@id":"b2g:hasDiagnosis","@type":"owl:ObjectProperty","label":"has diagnosis","domain":"b2g:Patient","range":"b2g:Diagnosis"},
    {"@id":"b2g:hasMedication","@type":"owl:ObjectProperty","label":"has medication","domain":"b2g:Patient","range":"b2g:MedicationStatement"},
    {"@id":"b2g:hasAppointment","@type":"owl:ObjectProperty","label":"has appointment","domain":"b2g:Patient","range":"b2g:Appointment"},
    {"@id":"b2g:assignedTo","@type":"owl:ObjectProperty","label":"assigned to","domain":"b2g:CareTeam","range":"b2g:EpisodeOfCare"},
    {"@id":"b2g:governs","@type":"owl:ObjectProperty","label":"governs","domain":"b2g:ConsentDirective","range":"b2g:ClinicalResource"},
    {"@id":"b2g:discloses","@type":"owl:ObjectProperty","label":"discloses","domain":"b2g:DisclosureEvent","range":"b2g:ClinicalResource"},
    {"@id":"b2g:actedOn","@type":"owl:ObjectProperty","label":"acted on","domain":"b2g:AuditEvent","range":"b2g:ClinicalResource"},
    {"@id":"b2g:describes","@type":"owl:ObjectProperty","label":"describes","domain":"b2g:ProvenanceRecord","range":"b2g:ClinicalResource"},
    {"@id":"b2g:attestsTo","@type":"owl:ObjectProperty","label":"attests to","domain":"b2g:Signature","range":"b2g:ProgressNote"},
    {"@id":"b2g:amends","@type":"owl:ObjectProperty","label":"amends","domain":"b2g:Amendment","range":"b2g:ProgressNote"},

    {"@id":"b2g:patientKey","@type":"owl:DatatypeProperty","label":"patient key","range":"xsd:string"},
    {"@id":"b2g:status","@type":"owl:DatatypeProperty","label":"status","range":"xsd:string"},
    {"@id":"b2g:version","@type":"owl:DatatypeProperty","label":"version","range":"xsd:integer"},
    {"@id":"b2g:occurredAt","@type":"owl:DatatypeProperty","label":"occurred at","range":"xsd:dateTime"},
    {"@id":"b2g:startAt","@type":"owl:DatatypeProperty","label":"start at","range":"xsd:dateTime"},
    {"@id":"b2g:endAt","@type":"owl:DatatypeProperty","label":"end at","range":"xsd:dateTime"},
    {"@id":"b2g:noteStyle","@type":"owl:DatatypeProperty","label":"note style","range":"xsd:string"},
    {"@id":"b2g:behaviorSection","@type":"owl:DatatypeProperty","label":"behavior section","range":"xsd:string"},
    {"@id":"b2g:interventionSection","@type":"owl:DatatypeProperty","label":"intervention section","range":"xsd:string"},
    {"@id":"b2g:responseSection","@type":"owl:DatatypeProperty","label":"response section","range":"xsd:string"},
    {"@id":"b2g:planSection","@type":"owl:DatatypeProperty","label":"plan section","range":"xsd:string"},
    {"@id":"b2g:codeSystem","@type":"owl:DatatypeProperty","label":"code system","range":"xsd:string"},
    {"@id":"b2g:code","@type":"owl:DatatypeProperty","label":"code","range":"xsd:string"},
    {"@id":"b2g:display","@type":"owl:DatatypeProperty","label":"display","range":"xsd:string"},
    {"@id":"b2g:signedAt","@type":"owl:DatatypeProperty","label":"signed at","range":"xsd:dateTime"},
    {"@id":"b2g:integrityHash","@type":"owl:DatatypeProperty","label":"integrity hash","range":"xsd:string"},
    {"@id":"b2g:purposeOfUse","@type":"owl:DatatypeProperty","label":"purpose of use","range":"xsd:string"},
    {"@id":"b2g:decision","@type":"owl:DatatypeProperty","label":"decision","range":"xsd:string"},
    {"@id":"b2g:breakGlass","@type":"owl:DatatypeProperty","label":"break glass","range":"xsd:boolean"},
    {"@id":"b2g:sourceSystem","@type":"owl:DatatypeProperty","label":"source system","range":"xsd:string"},
    {"@id":"b2g:sourceRecordId","@type":"owl:DatatypeProperty","label":"source record id","range":"xsd:string"},

    {"@id":"b2g:PUBLIC","@type":"b2g:SensitivityLabel","label":"Public"},
    {"@id":"b2g:INTERNAL","@type":"b2g:SensitivityLabel","label":"Internal"},
    {"@id":"b2g:PHI","@type":"b2g:SensitivityLabel","label":"Protected Health Information"},
    {"@id":"b2g:E_PHI","@type":"b2g:SensitivityLabel","label":"Electronic Protected Health Information"},
    {"@id":"b2g:DIRECT_IDENTIFIER","@type":"b2g:SensitivityLabel","label":"Direct Identifier"},
    {"@id":"b2g:BEHAVIORAL_HEALTH","@type":"b2g:SensitivityLabel","label":"Behavioral Health"},
    {"@id":"b2g:SUD_PART2","@type":"b2g:SensitivityLabel","label":"SUD / 42 CFR Part 2"},
    {"@id":"b2g:PSYCHOTHERAPY_NOTE","@type":"b2g:SensitivityLabel","label":"Psychotherapy Note"},
    {"@id":"b2g:HIGHLY_SENSITIVE","@type":"b2g:SensitivityLabel","label":"Highly Sensitive"},
    {"@id":"b2g:DEIDENTIFIED","@type":"b2g:SensitivityLabel","label":"De-identified"},
    {"@id":"b2g:LIMITED_DATASET","@type":"b2g:SensitivityLabel","label":"Limited Data Set"}
  ]
}
